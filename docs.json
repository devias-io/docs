{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Devias",
  "theme": "mint",
  "description": "Documentation for Devias, an open-source platform that works as an operating system for a business: records, workflows, agents and permissions in a core, with installable modules.",
  "colors": {
    "primary": "#ececec",
    "light": "#ececec",
    "dark": "#262626"
  },
  "background": {
    "color": {
      "light": "#0b0b0b",
      "dark": "#0b0b0b"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://devias.io"
  },
  "favicon": "/favicon.svg",
